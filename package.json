{
  "name": "xray",
  "private": true,
  "version": "0.5.17",
  "description": "xray \u00e2\u20ac\u201d a lightweight Discord client",
  "type": "module",
  "scripts": {
    "core:build": "node core/build.mjs",
    "equicord:build": "node equicord/build.mjs",
    "core:watch": "node core/build.mjs --watch",
    "typecheck": "tsc --noEmit -p core",
    "test": "node core/test/run.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test:server": "node server/test.mjs && node --test server/bot-history.test.mjs server/history-media.test.mjs server/message-archive.test.mjs server/recordings.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.5",
    "lucide-static": "^0.460.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "exifr": "7.1.3"
  }
}
