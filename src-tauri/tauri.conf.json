{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XRay",
  "version": "0.5.11",
  "identifier": "app.xray.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run core:build",
      "wait": true
    },
    "beforeBuildCommand": "npm run equicord:build && node scripts/installer.mjs && npm run core:build -- --release",
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "XRay project",
    "licenseFile": "../LICENSE",
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "SocialNetworking",
    "shortDescription": "A lightweight Discord client",
    "windows": {
      "nsis": {
        "template": "windows/generated/installer.nsi",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "startMenuFolder": "xray"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1QUVCQzg5M0U1NTNFQTMKUldTalBsVStpYnl1eGZ2ZHVGTmNBVjFmRlVCaS8zS3lyNTB3bTd3bVV1bm1BLzlISitHay81bmQK",
      "endpoints": [
        "https://github.com/chrischrischris11349-dot/xray/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
